PLACES_API_BASE_URL=http://127.0.0.1:8080
PLACES_PROVIDER_WEB_ORIGIN=http://127.0.0.1:3010
# optional display hint only (not the allowlist secret):
NEXT_PUBLIC_APP_NAME=دار كار — مقدم الخدمة
# Web Maps key — restrict to your domains + Maps JavaScript API + Places API (New). Never commit the value.
NEXT_PUBLIC_GOOGLE_MAPS_WEB_API_KEY=
# Optional Map ID for Advanced Markers.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
# Server Geocoding key — restrict to Geocoding API / IP. Never expose to the browser.
GOOGLE_MAPS_SERVER_API_KEY=
