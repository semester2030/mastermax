NODE_ENV=development
PORT=8080
HOST=0.0.0.0
DATABASE_URL=postgresql://user:password@localhost:5432/places
AUTH_MODE=stub
PAYMENT_PROVIDER=stub
FIREBASE_PROJECT_ID=example
STUB_WEBHOOK_SECRET=example-not-a-real-secret
HOLD_TTL_SECONDS=720
QUOTE_TTL_SECONDS=900
DEFAULT_COMMISSION_BPS=1000
WEBHOOK_MAX_SKEW_SECONDS=300
# Cloudflare Images + Stream (same account as DAR CAR Functions) — placeholders only.
# When set + CLOUDFLARE_MEDIA_ENABLED=true, Places Core uses real CF adapter.
CF_ACCOUNT_ID=example
CF_IMAGES_TOKEN=example-images-token
CF_IMAGES_HASH=example-images-hash
CF_STREAM_TOKEN=example-stream-token
CF_STREAM_SUBDOMAIN=customer-example
CLOUDFLARE_MEDIA_ENABLED=false
# Optional: PostgreSQL session work_mem for discovery sorts (placeholder example).
# Empty / default / 0 → server default (no override).
PG_WORK_MEM=16MB
# Memory budget ≈ PG_POOL_MAX * ~2 sort/hash nodes * work_mem
# Example: pool_max=20 × 2 × 16MB ≈ 640MB upper bound.
#
# Optional pool size override (production default 20; test default 40).
# Perf evidence MUST set PG_POOL_MAX=20.
# PG_POOL_MAX=20
#
# Production: AUTH_MODE=firebase and PAYMENT_PROVIDER must NOT be stub.
