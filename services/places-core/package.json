{
  "name": "places-core",
  "version": "0.3.3",
  "private": true,
  "description": "DAR CAR Places Core — independent booking engine (Gate 3)",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:worker": "node dist/workers/main.js",
    "migrate": "ts-node src/shared/database/migrate.ts",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "DATABASE_URL=${DATABASE_URL:-postgresql://127.0.0.1:5432/places_core_ci} node ./node_modules/jest/bin/jest.js --runInBand --detectOpenHandles",
    "test:db-safety": "DATABASE_URL=${DATABASE_URL:-postgresql://127.0.0.1:5432/places_core_ci} node ./node_modules/jest/bin/jest.js --runInBand --detectOpenHandles test/unit/db_safety_rc2.spec.ts",
    "test:acceptance": "DATABASE_URL=${DATABASE_URL:-postgresql://127.0.0.1:5432/places_core_ci} node ./node_modules/jest/bin/jest.js --runInBand --detectOpenHandles --testPathPattern=acceptance",
    "ci:install": "npm ci",
    "lines": "ts-node scripts/line-count.ts",
    "audit": "npm audit --omit=dev"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^8.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "firebase-admin": "^13.0.2",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/testing": "^10.4.15",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0"
  }
}
